# Terraform working directories (downloaded providers, large binaries)
**/.terraform/*

# State files: NEVER commit (they contain account details and sometimes secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Local variable files (may contain personal values)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Environment / OS files
.env
.DS_Store
Thumbs.db